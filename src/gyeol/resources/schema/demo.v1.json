{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gyeol.demo.v1",
  "title": "gyeol own-voice demo metadata (no audio)",
  "type": "object",
  "required": ["schema", "version", "sr", "ai_generated", "profile", "baseline", "steps"],
  "properties": {
    "schema": {"const": "gyeol.demo"},
    "version": {"const": 1},
    "selected_item": {"anyOf": [{"type": "null"}, {"type": "array"}]},
    "sr": {"type": "integer"},
    "ai_generated": {"const": true},
    "profile": {"enum": ["commercial", "research", "personal"]},
    "baseline": {"type": "object", "required": ["ai_generated", "consent_token_id", "voice_owner_sha256", "renderer", "watermark"]},
    "steps": {
      "type": "array",
      "items": {"type": "object", "required": ["label", "alpha", "selected", "clamped_fraction", "metadata"]}
    },
    "files": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
